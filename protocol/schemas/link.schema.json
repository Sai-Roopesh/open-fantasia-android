{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-fantasia.local/link.schema.json",
  "title": "Link",
  "description": "Everything the phone and the Mac say to each other (openspec/specs/mac-link). Every request carries the Fantasia-Contract header with the contract version; every response carries a trace id. Unions are flat objects with a kind field, so the Kotlin side stays plain data classes.",
  "$defs": {
    "ErrorCode": {
      "type": "string",
      "enum": [
        "unpaired",
        "version_mismatch",
        "busy",
        "stale_head",
        "not_found",
        "invalid",
        "model_failed",
        "internal"
      ]
    },
    "ErrorBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "trace_id"
          ],
          "properties": {
            "code": {
              "$ref": "#/$defs/ErrorCode"
            },
            "message": {
              "description": "Why, in words the player can read.",
              "type": "string"
            },
            "trace_id": {
              "type": "string"
            }
          },
          "title": "ErrorDetail"
        }
      }
    },
    "PairingInvite": {
      "description": "What the Mac's pairing QR code holds.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_id",
        "host_name",
        "addresses",
        "port",
        "code",
        "fingerprint",
        "contract"
      ],
      "properties": {
        "host_id": {
          "type": "string"
        },
        "host_name": {
          "type": "string"
        },
        "addresses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "port": {
          "type": "integer"
        },
        "code": {
          "description": "One-time pairing code, valid for ten minutes.",
          "type": "string"
        },
        "fingerprint": {
          "description": "SHA-256 of the Mac's certificate, which the phone pins.",
          "type": "string"
        },
        "contract": {
          "type": "integer"
        }
      }
    },
    "PairRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "device_name"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "device_name": {
          "type": "string"
        }
      }
    },
    "PairResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_token",
        "host_id",
        "host_name",
        "trace_id"
      ],
      "properties": {
        "device_token": {
          "type": "string"
        },
        "host_id": {
          "type": "string"
        },
        "host_name": {
          "type": "string"
        },
        "trace_id": {
          "type": "string"
        }
      }
    },
    "StoryList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stories",
        "trace_id"
      ],
      "properties": {
        "stories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StorySummary"
          }
        },
        "trace_id": {
          "type": "string"
        }
      }
    },
    "StorySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "standing",
        "updated_at",
        "detail"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "standing": {
          "description": "Where the Story stands on its current Path, as one line: \"Scene 14 · After curfew\" mid-Scene, \"Sunday 7:40 am · choosing where to go\" at the Day View.",
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        },
        "detail": {
          "description": "The line under the standing: \"Friday 9:52 pm · with Hermione\" mid-Scene, \"3 Scenes played\" at the Day View.",
          "type": "string"
        }
      }
    },
    "PersonCard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "portrait_url"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "portrait_url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "SceneCard": {
      "description": "A Scene's title card.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "title",
        "place",
        "at",
        "at_label",
        "people"
      ],
      "properties": {
        "number": {
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "place": {
          "type": "string"
        },
        "at": {
          "description": "Story time, \"Day N HH:MM\".",
          "type": "string"
        },
        "at_label": {
          "description": "Story time as people say it: \"Friday 9:40 pm\".",
          "type": "string"
        },
        "people": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PersonCard"
          },
          "description": "Who is in the Scene now besides the Player Character, with their Portraits; someone a Move or the Story brings in is added."
        }
      }
    },
    "Passage": {
      "description": "One Move or Reply, as it stands on the tree.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "text"
      ],
      "properties": {
        "entry_id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "Exchange": {
      "description": "A Move and the Reply that answered it. The opening Scene's first Reply has no Move.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "move",
        "reply"
      ],
      "properties": {
        "move": {
          "oneOf": [
            {
              "$ref": "#/$defs/Passage"
            },
            {
              "type": "null"
            }
          ]
        },
        "reply": {
          "oneOf": [
            {
              "$ref": "#/$defs/Passage"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "TurnState": {
      "description": "Whether a Reply is being written, has failed, or nothing is under way.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "idle",
            "writing",
            "failed"
          ]
        },
        "text_so_far": {
          "description": "While writing: the Reply's words so far.",
          "type": "string"
        },
        "reason": {
          "description": "When failed: why, in words the player can read.",
          "type": "string"
        },
        "trace_id": {
          "description": "When writing or failed: the turn's trace id.",
          "type": "string"
        }
      }
    },
    "SceneView": {
      "description": "The Scene screen as the Mac sees it on the Story's current Path.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "story_id",
        "path_id",
        "seq",
        "head_entry_id",
        "scene",
        "player_character",
        "earlier_scenes",
        "exchanges",
        "turn",
        "trace_id",
        "last_event_id",
        "focus",
        "linger",
        "day_view",
        "previously"
      ],
      "properties": {
        "story_id": {
          "type": "string"
        },
        "path_id": {
          "type": "string"
        },
        "seq": {
          "description": "The newest entry in the Story when this view was taken.",
          "type": "integer"
        },
        "head_entry_id": {
          "description": "The entry a Move must follow.",
          "type": "string"
        },
        "scene": {
          "$ref": "#/$defs/SceneCard"
        },
        "player_character": {
          "description": "The name of the person the player plays, for labelling their Moves.",
          "type": "string"
        },
        "earlier_scenes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SceneSummaryLine"
          }
        },
        "exchanges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Exchange"
          }
        },
        "turn": {
          "$ref": "#/$defs/TurnState"
        },
        "trace_id": {
          "type": "string"
        },
        "last_event_id": {
          "description": "The id of the newest event this view reflects, including the words of a Reply under way; the live stream resumes after it.",
          "type": "string"
        },
        "focus": {
          "description": "Who the Scene is focused on, or null.",
          "type": [
            "string",
            "null"
          ]
        },
        "linger": {
          "description": "Whether Linger is on.",
          "type": "boolean"
        },
        "day_view": {
          "description": "Present once the Scene has closed, by the Story or by End scene: the Day View, whose composer takes the next Move.",
          "oneOf": [
            {
              "$ref": "#/$defs/DayView"
            },
            {
              "type": "null"
            }
          ]
        },
        "previously": {
          "description": "Present when the player last played this Story more than a day ago and the Scene they are in, or the Scene that closed at the Day View, has a summary: the Previously card.",
          "oneOf": [
            {
              "$ref": "#/$defs/Previously"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "SceneSummaryLine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "title",
        "summary"
      ],
      "properties": {
        "number": {
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string",
          "description": "The Chronicler's one line for the Scene, or empty until it has written one."
        }
      }
    },
    "Previously": {
      "description": "The Previously card: where the Story stands, from the Chronicler's records, and when the player last played.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "since"
      ],
      "properties": {
        "summary": {
          "description": "The latest summary of the Scene the player is in (so far), or of the Scene that closed.",
          "type": "string"
        },
        "since": {
          "description": "When the player last played: the time the Path's head entry was written, ISO 8601.",
          "type": "string"
        }
      }
    },
    "MoveRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "after"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "after": {
          "description": "The entry the phone saw as the head; a Move after any other is refused as stale.",
          "type": "string"
        }
      }
    },
    "TurnAccepted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "move_entry_id",
        "trace_id"
      ],
      "properties": {
        "move_entry_id": {
          "type": "string"
        },
        "trace_id": {
          "type": "string"
        }
      }
    },
    "StoryEvent": {
      "description": "One event on a Story's live stream. Entry events (scene_opened, move, reply, scene_closed, focus_set, linger_set, redo) are replayed after a reconnect; reply_started, reply_delta and reply_failed describe the turn under way; world_moved and world_failed say the World has moved on, or could not, after a Scene ended. After scene_opened, scene_closed, redo, world_moved and world_failed the phone reads the Scene again, because they change more than one part of it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "seq"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "scene_opened",
            "move",
            "reply",
            "scene_closed",
            "focus_set",
            "linger_set",
            "redo",
            "reply_started",
            "reply_delta",
            "reply_failed",
            "world_moved",
            "world_failed"
          ]
        },
        "seq": {
          "description": "The newest entry this event follows.",
          "type": "integer"
        },
        "scene": {
          "$ref": "#/$defs/SceneCard",
          "description": "scene_opened and reply: the Scene's card as it stands."
        },
        "passage": {
          "$ref": "#/$defs/Passage"
        },
        "text": {
          "description": "reply_delta: the words that just arrived.",
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "trace_id": {
          "type": "string"
        },
        "day_view": {
          "description": "scene_closed: the Day View.",
          "$ref": "#/$defs/DayView"
        },
        "focus": {
          "description": "scene_opened and focus_set: who the Scene is focused on, or null.",
          "type": [
            "string",
            "null"
          ]
        },
        "linger": {
          "description": "linger_set: whether Linger is on.",
          "type": "boolean"
        }
      }
    },
    "DayView": {
      "description": "Where and when the Player Character is between Scenes, and what he learned meanwhile (openspec day-view).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at",
        "at_label",
        "day",
        "time",
        "place",
        "closed_by",
        "countdowns",
        "world",
        "scene_span",
        "meanwhile",
        "failure",
        "happenings",
        "choices"
      ],
      "properties": {
        "at": {
          "description": "Story time, \"Day N HH:MM\".",
          "type": "string"
        },
        "at_label": {
          "description": "Story time as people say it: \"Sunday 7:40 am\".",
          "type": "string"
        },
        "day": {
          "description": "The day as people say it: \"Sunday\", or \"Day 3\" when the Story has no weekdays.",
          "type": "string"
        },
        "time": {
          "description": "The time as people say it: \"7:40 am\".",
          "type": "string"
        },
        "place": {
          "description": "Where the Player Character is.",
          "type": "string"
        },
        "closed_by": {
          "description": "Who closed the last Scene: the Story, whose closing Reply can be redone, or the player, with End scene.",
          "type": "string",
          "enum": [
            "story",
            "player"
          ]
        },
        "countdowns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Countdown"
          }
        },
        "world": {
          "description": "Whether the World has moved on to the Day View's time: moving_on while the Weaver works (the phone says so in one line and takes no Move), ready, or failed (with failure).",
          "type": "string",
          "enum": [
            "moving_on",
            "ready",
            "failed"
          ]
        },
        "scene_span": {
          "description": "When the Scene that ended ran, as people say it: \"Friday 9:40 pm – 11:05 pm\".",
          "type": "string"
        },
        "meanwhile": {
          "description": "What the Player Character learned while elsewhere, once the World has moved on; empty before.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/MeanwhileItem"
          }
        },
        "failure": {
          "description": "Why the World could not move on, when world is failed; Retry is POST /stories/{id}/world/retry.",
          "oneOf": [
            {
              "$ref": "#/$defs/WorldFailure"
            },
            {
              "type": "null"
            }
          ]
        },
        "happenings": {
          "description": "What is on today that the Player Character could go to: at most four, the Story's pick first, once the World has moved on; empty before.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Happening"
          }
        },
        "choices": {
          "$ref": "#/$defs/DayChoices"
        }
      }
    },
    "Countdown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "landmark",
        "when",
        "label"
      ],
      "properties": {
        "landmark": {
          "type": "string"
        },
        "when": {
          "description": "How long to go: \"3 days\", \"Tomorrow\", \"Today at 8:30 pm\".",
          "type": "string"
        },
        "label": {
          "description": "\"3 days to Draconia's flying test\", \"Tomorrow: the first match\", \"Today at 6:00 pm: the feast\".",
          "type": "string"
        }
      }
    },
    "MeanwhileItem": {
      "description": "One line of Meanwhile, marked by how the Player Character learned it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "how"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "how": {
          "type": "string",
          "enum": [
            "seen",
            "told",
            "rumour"
          ]
        }
      }
    },
    "WorldFailure": {
      "description": "The Weaver could not move the World on.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "trace_id"
      ],
      "properties": {
        "reason": {
          "type": "string"
        },
        "trace_id": {
          "type": "string"
        }
      }
    },
    "Happening": {
      "description": "Something going on in the World at a time and place the Player Character could be at (openspec day-view: Up to four Happenings).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "at",
        "time",
        "place",
        "what",
        "who",
        "expected",
        "pick"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "at": {
          "description": "Story time, \"Day N HH:MM\".",
          "type": "string"
        },
        "time": {
          "description": "When, as people say it: \"9:00 am\", or \"Tomorrow 9:00 am\".",
          "type": "string"
        },
        "place": {
          "type": "string"
        },
        "what": {
          "description": "What is going on, and why it matters now.",
          "type": "string"
        },
        "who": {
          "description": "Who will be there, by name.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expected": {
          "description": "The Player Character is expected there: shown \"You're expected\".",
          "type": "boolean"
        },
        "pick": {
          "description": "The Story's own pick, which Let the Story choose goes to.",
          "type": "boolean"
        }
      }
    },
    "DayChoices": {
      "description": "What the Day View's other choices offer: people to follow, places to go, and times to skip to.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "follow",
        "places",
        "skips"
      ],
      "properties": {
        "follow": {
          "description": "People the Player Character could follow: the Leads and whoever was in the Scene that ended.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "places": {
          "description": "The Story's places to go to.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skips": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Skip"
          }
        }
      }
    },
    "Skip": {
      "description": "A later time to skip to: this evening, tomorrow, the weekend, the next Landmark.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "at",
        "time"
      ],
      "properties": {
        "label": {
          "description": "\"This evening\", \"Tomorrow\", \"The weekend\", or the Landmark's name.",
          "type": "string"
        },
        "at": {
          "type": "string"
        },
        "time": {
          "description": "As people say it: \"Saturday 6:00 pm\".",
          "type": "string"
        }
      }
    },
    "ChooseRequest": {
      "description": "A choice at the Day View (openspec day-view: The player chooses where to be). The Mac writes it as the player's Move, the Gap first.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "after",
        "kind",
        "gap"
      ],
      "properties": {
        "after": {
          "description": "The entry the choice follows: the Day View's head.",
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "go",
            "follow",
            "somewhere",
            "skip",
            "story"
          ]
        },
        "happening": {
          "description": "go: the Happening's id; left out or null for the other kinds.",
          "type": [
            "string",
            "null"
          ]
        },
        "who": {
          "description": "follow: who; left out or null for the other kinds.",
          "type": [
            "string",
            "null"
          ]
        },
        "place": {
          "description": "somewhere: the place; left out or null for the other kinds.",
          "type": [
            "string",
            "null"
          ]
        },
        "at": {
          "description": "skip: the time skipped to; left out or null for the other kinds.",
          "type": [
            "string",
            "null"
          ]
        },
        "gap": {
          "description": "What the Player Character did in the Gap, in the player's words, or null: left blank, he spent it quietly where he was.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "EndSceneRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "after"
      ],
      "properties": {
        "after": {
          "description": "The head the phone saw; refused as stale if the Story has moved on.",
          "type": "string"
        }
      }
    },
    "FocusRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "after",
        "on"
      ],
      "properties": {
        "after": {
          "type": "string"
        },
        "on": {
          "description": "The person to focus on, by name, or null to clear Focus.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "LingerRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "after",
        "on"
      ],
      "properties": {
        "after": {
          "type": "string"
        },
        "on": {
          "type": "boolean"
        }
      }
    },
    "RedoRequest": {
      "description": "Write the latest Reply again. The Direction reaches the Writer only, never the Story.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "after",
        "direction",
        "remember"
      ],
      "properties": {
        "after": {
          "description": "The head the phone saw: the latest Reply, or the end of the Scene that Reply closed.",
          "type": "string"
        },
        "direction": {
          "type": [
            "string",
            "null"
          ]
        },
        "remember": {
          "description": "Keep the Direction as a line of Taste.",
          "type": "boolean"
        }
      }
    },
    "Accepted": {
      "description": "A change to the Story that is done when it is answered.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head_entry_id",
        "trace_id"
      ],
      "properties": {
        "head_entry_id": {
          "type": "string"
        },
        "trace_id": {
          "type": "string"
        }
      }
    },
    "PastScene": {
