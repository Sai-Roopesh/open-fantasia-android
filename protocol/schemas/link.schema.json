{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-fantasia.local/link.schema.json",
  "title": "Link",
  "description": "Everything the phone and the Mac say to each other (openspec/specs/mac-link). Every request carries the Fantasia-Contract header with the contract version; every response carries a trace id. Unions are flat objects with a kind field, so the Kotlin side stays plain data classes.",
  "$defs": {
    "ErrorCode": {
      "type": "string",
      "enum": [
        "unpaired",
        "version_mismatch",
        "busy",
        "stale_head",
        "not_found",
        "invalid",
        "model_failed",
        "internal"
      ]
    },
    "ErrorBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "trace_id"
          ],
          "properties": {
            "code": {
              "$ref": "#/$defs/ErrorCode"
            },
            "message": {
              "description": "Why, in words the player can read.",
              "type": "string"
            },
            "trace_id": {
              "type": "string"
            }
          },
          "title": "ErrorDetail"
        }
      }
    },
    "PairingInvite": {
      "description": "What the Mac's pairing QR code holds.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_id",
        "host_name",
        "addresses",
        "port",
        "code",
        "fingerprint",
        "contract"
      ],
      "properties": {
        "host_id": {
          "type": "string"
        },
        "host_name": {
          "type": "string"
        },
        "addresses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "port": {
          "type": "integer"
        },
        "code": {
          "description": "One-time pairing code, valid for ten minutes.",
          "type": "string"
        },
        "fingerprint": {
          "description": "SHA-256 of the Mac's certificate, which the phone pins.",
          "type": "string"
        },
        "contract": {
          "type": "integer"
        }
      }
    },
    "PairRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "device_name"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "device_name": {
          "type": "string"
        }
      }
    },
    "PairResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_token",
        "host_id",
        "host_name",
        "trace_id"
      ],
      "properties": {
        "device_token": {
          "type": "string"
        },
        "host_id": {
          "type": "string"
        },
        "host_name": {
          "type": "string"
        },
        "trace_id": {
          "type": "string"
        }
      }
    },
    "StoryList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stories",
        "trace_id"
      ],
      "properties": {
        "stories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StorySummary"
          }
        },
        "trace_id": {
          "type": "string"
        }
      }
    },
    "StorySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "standing",
        "updated_at"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "standing": {
          "description": "Where the Story stands on its current Path, as one line: \"Scene 14 · After curfew\".",
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        }
      }
    },
    "PersonCard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "portrait_url"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "portrait_url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "SceneCard": {
      "description": "A Scene's title card.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "title",
        "place",
        "at",
        "at_label",
        "people"
      ],
      "properties": {
        "number": {
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "place": {
          "type": "string"
        },
        "at": {
          "description": "Story time, \"Day N HH:MM\".",
          "type": "string"
        },
        "at_label": {
          "description": "Story time as people say it: \"Friday · 9:40 pm\".",
          "type": "string"
        },
        "people": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PersonCard"
          },
          "description": "Who is in the Scene now besides the Player Character, with their Portraits; someone a Move or the Story brings in is added."
        }
      }
    },
    "Passage": {
      "description": "One Move or Reply, as it stands on the tree.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "text"
      ],
      "properties": {
        "entry_id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "Exchange": {
      "description": "A Move and the Reply that answered it. The opening Scene's first Reply has no Move.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "move",
        "reply"
      ],
      "properties": {
        "move": {
          "oneOf": [
            {
              "$ref": "#/$defs/Passage"
            },
            {
              "type": "null"
            }
          ]
        },
        "reply": {
          "oneOf": [
            {
              "$ref": "#/$defs/Passage"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "TurnState": {
      "description": "Whether a Reply is being written, has failed, or nothing is under way.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "idle",
            "writing",
            "failed"
          ]
        },
        "text_so_far": {
          "description": "While writing: the Reply's words so far.",
          "type": "string"
        },
        "reason": {
          "description": "When failed: why, in words the player can read.",
          "type": "string"
        },
        "trace_id": {
          "description": "When writing or failed: the turn's trace id.",
          "type": "string"
        }
      }
    },
    "SceneView": {
      "description": "The Scene screen as the Mac sees it on the Story's current Path.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "story_id",
        "path_id",
        "seq",
        "head_entry_id",
        "scene",
        "player_character",
        "earlier_scenes",
        "exchanges",
        "turn",
        "trace_id",
        "last_event_id",
        "focus",
        "linger",
        "day_view"
      ],
      "properties": {
        "story_id": {
          "type": "string"
        },
        "path_id": {
          "type": "string"
        },
        "seq": {
          "description": "The newest entry in the Story when this view was taken.",
          "type": "integer"
        },
        "head_entry_id": {
          "description": "The entry a Move must follow.",
          "type": "string"
        },
        "scene": {
          "$ref": "#/$defs/SceneCard"
        },
        "player_character": {
          "description": "The name of the person the player plays, for labelling their Moves.",
          "type": "string"
        },
        "earlier_scenes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SceneSummaryLine"
          }
        },
        "exchanges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Exchange"
          }
        },
        "turn": {
          "$ref": "#/$defs/TurnState"
        },
        "trace_id": {
          "type": "string"
        },
        "last_event_id": {
          "description": "The id of the newest event this view reflects, including the words of a Reply under way; the live stream resumes after it.",
          "type": "string"
        },
        "focus": {
          "description": "Who the Scene is focused on, or null.",
          "type": [
            "string",
            "null"
          ]
        },
        "linger": {
          "description": "Whether Linger is on.",
          "type": "boolean"
        },
        "day_view": {
          "description": "Present once the Scene has closed, by the Story or by End scene: the Day View, whose composer takes the next Move.",
          "oneOf": [
            {
              "$ref": "#/$defs/DayView"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "SceneSummaryLine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "title",
        "summary"
      ],
      "properties": {
        "number": {
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "MoveRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "after"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "after": {
          "description": "The entry the phone saw as the head; a Move after any other is refused as stale.",
          "type": "string"
        }
      }
    },
    "TurnAccepted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "move_entry_id",
        "trace_id"
      ],
      "properties": {
        "move_entry_id": {
          "type": "string"
        },
        "trace_id": {
          "type": "string"
        }
      }
    },
    "StoryEvent": {
      "description": "One event on a Story's live stream. Entry events (scene_opened, move, reply, scene_closed, focus_set, linger_set, redo) are replayed after a reconnect; reply_started, reply_delta and reply_failed describe the turn under way. After scene_opened, scene_closed and redo the phone reads the Scene again, because they change more than one part of it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "seq"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "scene_opened",
            "move",
            "reply",
            "scene_closed",
            "focus_set",
            "linger_set",
            "redo",
            "reply_started",
            "reply_delta",
            "reply_failed"
          ]
        },
        "seq": {
          "description": "The newest entry this event follows.",
          "type": "integer"
        },
        "scene": {
          "$ref": "#/$defs/SceneCard",
          "description": "scene_opened and reply: the Scene's card as it stands."
        },
        "passage": {
          "$ref": "#/$defs/Passage"
        },
        "text": {
          "description": "reply_delta: the words that just arrived.",
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "trace_id": {
          "type": "string"
        },
        "day_view": {
          "description": "scene_closed: the Day View.",
          "$ref": "#/$defs/DayView"
        },
        "focus": {
          "description": "scene_opened and focus_set: who the Scene is focused on, or null.",
          "type": [
            "string",
            "null"
          ]
        },
        "linger": {
          "description": "linger_set: whether Linger is on.",
          "type": "boolean"
        }
      }
    },
    "DayView": {
      "description": "Where and when the Player Character is between Scenes (openspec day-view).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at",
        "at_label",
        "place",
        "closed_by",
        "countdowns"
      ],
      "properties": {
        "at": {
          "description": "Story time, \"Day N HH:MM\".",
          "type": "string"
        },
        "at_label": {
          "description": "Story time as people say it: \"Sunday · 7:40 am\".",
          "type": "string"
        },
        "place": {
          "description": "Where the Player Character is.",
          "type": "string"
        },
        "closed_by": {
          "description": "Who closed the last Scene: the Story, whose closing Reply can be redone, or the player, with End scene.",
          "type": "string",
          "enum": [
            "story",
            "player"
          ]
        },
        "countdowns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Countdown"
          }
        }
      }
    },
    "Countdown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "landmark",
        "label"
      ],
      "properties": {
        "landmark": {
          "type": "string"
        },
        "label": {
          "description": "\"3 days to Draconia's flying test\", \"Tomorrow: the first match\", \"Today at 6:00 pm: the feast\".",
          "type": "string"
        }
      }
    },
    "EndSceneRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "after"
      ],
      "properties": {
        "after": {
          "description": "The head the phone saw; refused as stale if the Story has moved on.",
          "type": "string"
        }
      }
    },
    "FocusRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "after",
        "on"
      ],
      "properties": {
        "after": {
          "type": "string"
        },
        "on": {
          "description": "The person to focus on, by name, or null to clear Focus.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "LingerRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "after",
        "on"
      ],
      "properties": {
        "after": {
          "type": "string"
        },
        "on": {
          "type": "boolean"
        }
      }
    },
    "RedoRequest": {
      "description": "Write the latest Reply again. The Direction reaches the Writer only, never the Story.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "after",
        "direction",
        "remember"
      ],
      "properties": {
        "after": {
          "description": "The head the phone saw: the latest Reply, or the end of the Scene that Reply closed.",
          "type": "string"
        },
        "direction": {
          "type": [
            "string",
            "null"
          ]
        },
        "remember": {
          "description": "Keep the Direction as a line of Taste.",
          "type": "boolean"
        }
      }
    },
    "Accepted": {
      "description": "A change to the Story that is done when it is answered.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head_entry_id",
        "trace_id"
      ],
      "properties": {
        "head_entry_id": {
          "type": "string"
        },
        "trace_id": {
          "type": "string"
        }
      }
    }
  }
}
